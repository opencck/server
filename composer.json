{
    "name": "opencck/server",
    "description": "HTTP/WS/SSE non-blocking server based on revolt event loop and amphp-v3",
    "version": "1.1.1",
    "license": "MIT",
    "require": {
        "amphp/http": "v2.1.2",
        "amphp/http-server": "v3.4.4",
        "amphp/http-server-router": "v2.0.0",
        "amphp/http-server-static-content": "v2.0.0",
        "amphp/http-server-form-parser": "v2.0.0",
        "amphp/websocket": "v2.0.4",
        "amphp/websocket-server": "v4.0.0",
        "amphp/log": "v2.0.0",
        "symfony/polyfill-intl-idn": "^1.33"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "amphp/phpunit-util": "^3",
        "amphp/http-client": "v5.0.1",
        "amphp/websocket-client": "v2.0.0"
    }
}
